# --- Datos derivados (reproducibles con los pipelines) ---
data/interim/*
data/processed/*
!data/interim/.gitkeep
!data/processed/.gitkeep

# --- Credenciales · NUNCA se versionan ---
service/.secrets/
*.json.key
credenciales*.json

# --- Entorno virtual ---
.venv/
venv/
env/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Tests / tooling ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# --- Notebooks ---
.ipynb_checkpoints/

# --- Sistema / editores ---
.DS_Store
.vscode/
.idea/
*.swp

# --- Ficheros temporales de Excel ---
~$*.xlsx

# --- Salidas generadas ---
# El informe del Reto 1 SÍ se versiona: es el entregable que se reparte, y el
# enlace al servicio del Reto 2 vive dentro. Si no estuviera en el repositorio,
# quien lo abriese desde GitHub leería una copia vieja.
